---
import { registrationGuide as guide } from '../data/registration';
import '../styles/registration-guide.css';
---
<section class="registration-section page-width" aria-label="이능력자 등록 안내">
  <!-- A regular link remains usable without JavaScript; enhanced to a modal below. -->
  <a class="registration-banner" href="/ranger-id/" data-registration-open aria-haspopup="dialog" aria-controls="registration-dialog">
    <span class="registration-symbol" aria-hidden="true">
      <svg viewBox="0 0 80 88" fill="none"><path d="M14 7h37l15 15v59H14z" stroke="currentColor" stroke-width="3"/><path d="M51 7v16h15M27 54h27M27 64h18" stroke="currentColor" stroke-width="3"/><circle cx="33" cy="36" r="6" fill="currentColor"/><path d="m46 38 5 5 11-12" stroke="currentColor" stroke-width="3"/></svg>
    </span>
    <span class="registration-banner-copy"><span class="registration-label">{guide.label}</span><strong>{guide.subject} <span>{guide.action}</span></strong><span class="registration-summary">{guide.summary}</span></span>
    <span class="registration-arrow" aria-hidden="true">↗</span>
  </a>
</section>

<dialog id="registration-dialog" class="registration-dialog" aria-labelledby="registration-title">
  <div class="registration-dialog-shell">
    <header class="registration-dialog-header">
      <div><span class="registration-label">{guide.dialogLabel}</span><h2 id="registration-title">{guide.dialogTitle}</h2></div>
      <button class="registration-close" type="button" data-registration-close aria-label="등록 안내 닫기" autofocus><span aria-hidden="true">×</span></button>
    </header>
    <div class="registration-options">
      {guide.services.map((service, index) => <a class="registration-option" href={service.href} target={service.external ? '_blank' : undefined} rel={service.external ? 'noopener noreferrer' : undefined}>
        <span class="registration-option-top"><span aria-hidden="true">0{index + 1}</span><span>{service.subtitle}</span></span>
        <h3>{service.title}</h3>
        <p>{service.description}</p>
        <span class="registration-option-action">{service.action}<span aria-hidden="true">{service.external ? '↗' : '→'}</span>{service.external && <span class="registration-sr-only"> (새 탭에서 열기)</span>}</span>
      </a>)}
    </div>
  </div>
</dialog>
<script>
  import '../scripts/registration-guide';
</script>
