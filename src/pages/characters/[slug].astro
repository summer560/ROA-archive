---
import Base from '../../layouts/Base.astro';
export function getStaticPaths(){return Object.values(import.meta.glob('../../content/characters/*.md',{eager:true})).filter((c:any)=>!c.frontmatter.draft).map((character:any)=>({params:{slug:character.frontmatter.slug},props:{character}}));}
const {character}=Astro.props;
const data=character.frontmatter;
const Content=character.Content;
---
<Base title={data.name} description={data.description} category="characters"><article class="character-detail page-width"><a class="text-link" href="/characters/">← CHARACTERS</a><div class="character-profile"><img src={data.image} alt={data.imageAlt||data.name} width="750" height="1000" /><div><span class="eyebrow">{data.organization}</span><h1>{data.name}</h1>{data.nameEn&&<p class="character-en">{data.nameEn}</p>}<dl>{Object.entries(data.profile||{}).map(([key,value])=><div><dt>{key}</dt><dd>{String(value)}</dd></div>)}</dl></div></div><div class="prose"><Content /></div></article></Base>
